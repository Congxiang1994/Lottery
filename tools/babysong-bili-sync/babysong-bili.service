[Unit]
Description=Refresh Super Simple Songs Bilibili video links (recover taken-down / find latest)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/lottery
# 纯标准库实现，无需额外依赖；脚本相对路径定位 catalog.json
# --recheck：每日用严格整词匹配重新检索全部 518 首，清理误匹配（名字对不上的会被清掉，仅保留 YouTube）
ExecStart=/usr/bin/python3 /opt/lottery/tools/babysong-bili-sync/gather.py --recheck
