[Unit]
Description=Lottery Easy API (FastAPI + gunicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/lottery_easy/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lottery_easy/backend/.venv/bin/gunicorn \
    -k uvicorn.workers.UvicornWorker \
    -w 2 \
    -b 127.0.0.1:8000 \
    app.main:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
