[Unit]
Description=Lottery · 每晚全量跑算法并入库
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/lottery/backend
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/lottery/backend
ExecStart=/opt/lottery/backend/.venv/bin/python /opt/lottery/backend/scripts/run_all_algorithms.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

# 失败也保留日志，方便排查
SuccessExitStatus=0
TimeoutStartSec=1800
